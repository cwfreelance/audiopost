{
  "name": "audiopost",
  "logo": "Scallop stamp (artboard 1), level-meter mark",
  "color": {
    "stamp":         { "hex": "#d6336c", "rgb": [214, 51, 108],  "use": "Stamp shape" },
    "mark":          { "hex": "#f0f0f0", "rgb": [240, 240, 240], "use": "Level-meter bars inside the stamp" },
    "lightBg":       { "hex": "#f0f0f0", "rgb": [240, 240, 240], "use": "Light background" },
    "audioOnLight":  { "hex": "#000000", "rgb": [0, 0, 0],       "use": "\"AUDIO\" on light backgrounds" },
    "postOnLight":   { "hex": "#d6336c", "rgb": [214, 51, 108],  "use": "\"POST\" on light backgrounds" },
    "darkBg":        { "hex": "#000000", "rgb": [0, 0, 0],       "use": "Dark background" },
    "audioOnDark":   { "hex": "#f0f0f0", "rgb": [240, 240, 240], "use": "\"AUDIO\" on dark backgrounds" },
    "postOnDark":    { "hex": "#d6336c", "rgb": [214, 51, 108],  "use": "\"POST\" on dark backgrounds" },
    "appTileBg":     { "hex": "#d6336c", "rgb": [214, 51, 108],  "use": "App-icon tile" },
    "appTileStamp":  { "hex": "#f0f0f0", "rgb": [240, 240, 240], "use": "Stamp on the app-icon tile" },
    "appTileMark":   { "hex": "#d6336c", "rgb": [214, 51, 108],  "use": "Meter bars on the app-icon tile" }
  },
  "typography": {
    "wordmark": {
      "fontFamily": "Londrina Solid",
      "fontWeight": 400,
      "fontStyle": "normal",
      "textTransform": "uppercase",
      "letterSpacing": "0",
      "lineHeight": 1,
      "text": "AUDIOPOST (AUDIO + POST in two colors, no space)"
    }
  },
  "lockup": {
    "units": "CSS px at the mockup's size; scale everything together",
    "markBox": 108,
    "gapMarkToText": 14,
    "fontSize": 70,
    "fontSizeToMarkBoxRatio": 0.6481,
    "gapToMarkBoxRatio": 0.1296,
    "width": 406.5625,
    "height": 108,
    "textLeft": 122,
    "textBaselineFromTop": 78,
    "verticalAlign": "text line box centered on the mark box"
  },
  "mark": {
    "viewBox": "0 0 100 100",
    "stampBounds": { "x": 14.19, "y": 7.58, "width": 71.62, "height": 84.84 },
    "roughness": 5,
    "roughnessNote": "Baked into the SVG paths in svg/ (traced from the live filter). svg/audiopost-mark-clean.svg is the same mark without roughness."
  },
  "appIcon": { "tile": 64, "cornerRadius": 6, "markBox": 52, "inset": 6 }
}
